{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rosetta",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const T={'.html':'text/html; charset=utf-8','.json':'application/json','.svg':'image/svg+xml'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const fp=p.join(process.cwd(),u);if(!fp.startsWith(process.cwd())){s.writeHead(403);s.end();return}f.readFile(fp,(e,d)=>{if(e){s.writeHead(404);s.end('not found');return}s.writeHead(200,{'Content-Type':T[p.extname(fp)]||'application/octet-stream'});s.end(d)})}).listen(4321,()=>console.log('serving on http://localhost:4321'))"
      ],
      "port": 4321
    }
  ]
}
